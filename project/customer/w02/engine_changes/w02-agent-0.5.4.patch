diff --color -ruN -x . a/tests/test_quote_trim.py b/tests/test_quote_trim.py
--- a/tests/test_quote_trim.py	1969-12-31 16:00:00
+++ b/tests/test_quote_trim.py	2026-10-31 09:20:40
@@ -0,0 +1,36 @@
+"""No network: only a trailing “。” the source lacks is trimmed; every other mismatch is left for validation."""
+from fde_product.interview_extraction import merge_claims, TRIMMED_PERIOD_NOTE
+
+TRANSCRIPTS = [{"meeting_id": "M1", "messages": [{"id": "MSG-1", "content": "口径需要项目组核实；80 万活跃会员没有统计。"}]}]
+
+
+def claim(quote):
+    return {"id": "x", "statement": "s", "kind": "fact", "evidence_status": "reported", "qualifiers": [],
+            "evidence": [{"meeting_id": "M1", "message_id": "MSG-1", "quote": quote}],
+            "conflict_ids": [], "review": {"status": "pending", "note": ""}}
+
+
+def merged(quote):
+    return merge_claims([{"claims": [claim(quote)]}], TRANSCRIPTS)[0]
+
+
+def test_added_trailing_period_is_trimmed_and_noted():
+    c = merged("口径需要项目组核实。")
+    assert c["evidence"][0]["quote"] == "口径需要项目组核实"
+    assert c["qualifiers"] == [TRIMMED_PERIOD_NOTE]
+
+
+def test_exact_quote_is_untouched():
+    c = merged("80 万活跃会员没有统计。")
+    assert c["evidence"][0]["quote"] == "80 万活跃会员没有统计。" and c["qualifiers"] == []
+
+
+def test_other_mismatches_are_not_repaired():
+    for quote in ("口径需要核实。", "口径需要项目组核实！", "。", "口径需要项目组核实；80万"):
+        c = merged(quote)
+        assert c["evidence"][0]["quote"] == quote and c["qualifiers"] == []
+
+
+def test_without_transcripts_nothing_changes():
+    c = merge_claims([{"claims": [claim("口径需要项目组核实。")]}])[0]
+    assert c["evidence"][0]["quote"] == "口径需要项目组核实。"
diff --color -ruN -x . a/tests/test_set_aside.py b/tests/test_set_aside.py
--- a/tests/test_set_aside.py	1969-12-31 16:00:00
+++ b/tests/test_set_aside.py	2026-10-31 09:39:20
@@ -0,0 +1,47 @@
+"""No network: unquotable claims are moved aside and recorded instead of voiding the run."""
+import hashlib
+import json
+from test_w02_extraction import Fixture, sample, run_sample  # noqa: F401  (pytest fixture)
+from fde_product.interview_extraction import validate_run, CheckError
+import pytest
+
+
+def broken_first_claim(data, result):
+    if "claims" not in result:
+        return result
+    claims = result["claims"]
+    bad_quote = {**claims[0], "evidence": [{**claims[0]["evidence"][0], "quote": "原文没有的句子"}]}
+    bad_ref = {**claims[1], "evidence": [dict(meeting_id="missing", message_id="MSG-1", quote="x")]}
+    return {"claims": [bad_quote, bad_ref] + claims[2:]}
+
+
+def test_unquotable_claims_are_set_aside_and_the_run_succeeds(sample):
+    model = Fixture(broken_first_claim)
+    ws, path, run = run_sample(sample, model)
+    assert run["status"] == "succeeded"
+    aside = ws.verify(next(r for r in run["outputs"] if r["path"].endswith("/set_aside.json")))
+    assert [p["reason"] for a in aside for p in a["problems"]] == ["QUOTE_NOT_FOUND", "REFERENCE_INVALID"]
+    facts = ws.verify(next(r for r in run["outputs"] if r["path"].endswith("/candidates.json")))
+    kept = {c["id"] for c in facts["claims"]}
+    assert kept and not kept & {a["claim"]["id"] for a in aside}
+    assert all(c["id"] in kept for c in model.calls[-1]["claims"]) and len(model.calls[-1]["claims"]) == len(kept)
+    assert validate_run(ws, path) == run
+
+
+def test_tampered_set_aside_record_is_detected(sample):
+    ws, path, run = run_sample(sample, Fixture(broken_first_claim))
+    ref = next(r for r in run["outputs"] if r["path"].endswith("/set_aside.json"))
+    aside = ws.verify(ref)
+    aside[0]["problems"][0]["reason"] = "EDITED"
+    raw = json.dumps(aside, ensure_ascii=False, indent=2).encode()
+    ws.path(ref["path"]).write_bytes(raw)
+    ref["sha256"] = hashlib.sha256(raw).hexdigest()
+    ws.path(path).write_text(json.dumps(run, ensure_ascii=False))
+    with pytest.raises(CheckError, match="EXTRACTION_MISMATCH"):
+        validate_run(ws, path)
+
+
+def test_clean_run_writes_no_set_aside_record(sample):
+    ws, path, run = run_sample(sample)
+    assert not any(r["path"].endswith("/set_aside.json") for r in run["outputs"])
+    validate_run(ws, path)
diff --color -ruN -x . a/tests/test_stream_patch.py b/tests/test_stream_patch.py
--- a/tests/test_stream_patch.py	1969-12-31 16:00:00
+++ b/tests/test_stream_patch.py	2026-10-31 08:05:35
@@ -0,0 +1,76 @@
+"""No network: the opt-in streaming path and its record reconstruction."""
+import json
+import time
+import pytest
+from fde_product.models import CompatibleModel, ModelError, read_stream
+from fde_product.interview_extraction import ExtractionModel, expected_model_request
+
+
+def sse(*chunks):
+    return [f"data: {json.dumps(c, ensure_ascii=False)}\n".encode() for c in chunks] + [b"data: [DONE]\n"]
+
+
+def make(**kw):
+    return CompatibleModel(url="https://example.invalid/chat", key="k", model="m", **kw)
+
+
+def test_stream_chunks_become_a_normal_body():
+    lines = sse({"id": "r1", "choices": [{"delta": {"role": "assistant", "reasoning_content": "想"}}]},
+                {"id": "r1", "choices": [{"delta": {"content": "{\"a\":"}}]},
+                {"id": "r1", "choices": [{"delta": {"content": "1}"}, "finish_reason": "stop"}]},
+                {"id": "r1", "choices": [], "usage": {"prompt_tokens": 3, "completion_tokens": 5, "total_tokens": 8}})
+    body = read_stream(iter([b": keep-alive\n"] + lines), time.monotonic() + 60)
+    assert body["id"] == "r1"
+    assert body["choices"][0] == {"message": {"role": "assistant", "content": "{\"a\":1}", "reasoning_content": "想"},
+                                  "finish_reason": "stop"}
+    assert body["usage"]["total_tokens"] == 8
+
+
+def test_chunk_overhead_does_not_count_as_a_large_reply():
+    filler = "x" * 400
+    chunks = [{"id": "r", "pad": filler, "choices": [{"delta": {"content": "字"}}]} for _ in range(6000)]
+    body = read_stream(iter(sse(*chunks)), time.monotonic() + 60)
+    assert len(body["choices"][0]["message"]["content"]) == 6000
+
+
+def test_assembled_text_over_limit_is_rejected():
+    chunks = [{"choices": [{"delta": {"content": "x" * 100_000}}]} for _ in range(25)]
+    with pytest.raises(ModelError):
+        read_stream(iter(sse(*chunks)), time.monotonic() + 60)
+
+
+def test_stream_error_chunk_is_rejected():
+    with pytest.raises(ValueError):
+        read_stream(iter(sse({"error": {"message": "x"}})), time.monotonic() + 60)
+
+
+def test_stream_past_deadline_times_out():
+    with pytest.raises(TimeoutError):
+        read_stream(iter(sse({"choices": [{"delta": {"content": "x"}}]})), time.monotonic() - 1)
+
+
+def test_off_by_default_keeps_original_request_and_policy(monkeypatch):
+    monkeypatch.delenv("FDE_MODEL_STREAM", raising=False)
+    m = make()
+    assert m._payload([], [])["stream"] is False and "stream_options" not in m._payload([], [])
+    assert "stream" not in m.policy_config()
+
+
+def test_on_streams_only_without_tools(monkeypatch):
+    monkeypatch.setenv("FDE_MODEL_STREAM", "1")
+    m = make()
+    assert m._payload([], [])["stream"] is True and m.policy_config()["stream"] is True
+    assert m._payload([], [{"type": "function"}])["stream"] is False
+
+
+def test_checker_reconstruction_follows_the_record_not_the_shell(monkeypatch):
+    monkeypatch.setenv("FDE_MODEL_STREAM", "1")
+    streamed = ExtractionModel(url="https://example.invalid/chat", key="k", model="m")
+    streamed.phase = "extract"
+    policy = streamed.policy_config()
+    assert expected_model_request("compatible", "m", [], policy, phase="extract") == streamed._payload([], [])
+    monkeypatch.setenv("FDE_MODEL_STREAM", "")
+    plain = ExtractionModel(url="https://example.invalid/chat", key="k", model="m")
+    plain.phase = "extract"
+    monkeypatch.setenv("FDE_MODEL_STREAM", "1")
+    assert expected_model_request("compatible", "m", [], plain.policy_config(), phase="extract")["stream"] is False
