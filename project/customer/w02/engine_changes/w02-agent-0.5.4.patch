+def read_stream(response,deadline):
+    """Assemble OpenAI-style SSE chunks into the same body shape as a non-streaming reply."""
+    content,reasoning,finish,usage,rid,raw,text=[],[],None,None,None,0,0
+    for line in response:
+        # Each SSE chunk wraps a few characters in hundreds of bytes, so cap the assembled text separately.
+        raw+=len(line)
+        if raw>200_000_000 or text>2_000_000:raise ModelError("MODEL_RESPONSE_TOO_LARGE")
+        if time.monotonic()>deadline:raise TimeoutError()
+        line=line.decode("utf-8").strip()
+        if not line.startswith("data:"):continue
+        data=line[5:].strip()
+        if data=="[DONE]":break
+        chunk=json.loads(data)
+        if "error" in chunk:raise ValueError("stream error")
+        rid=chunk.get("id",rid)
+        if chunk.get("usage"):usage=chunk["usage"]
+        for choice in chunk.get("choices") or []:
+            delta=choice.get("delta") or {}
+            if delta.get("tool_calls"):raise ValueError("tool calls are not streamed")
+            for key,parts in (("content",content),("reasoning_content",reasoning)):
+                if isinstance(delta.get(key),str):parts.append(delta[key]);text+=len(delta[key])
+            if choice.get("finish_reason"):finish=choice["finish_reason"]
+    message={"role":"assistant","content":"".join(content)}
+    if reasoning:message["reasoning_content"]="".join(reasoning)
+    body={"choices":[{"message":message,"finish_reason":finish}],"usage":usage or {}}
+    if rid is not None:body["id"]=rid
+    return body
+
